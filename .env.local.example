# Forged in the Fire - Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://forgedinthefire.com
NEXT_PUBLIC_SITE_NAME=Forged in the Fire

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=bsalsbury@forgedinthefirellc.org
RESEND_TO_EMAIL=bsalsbury@forgedinthefirellc.org

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=forgedinthefire.com

# Security
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxx

# CMS (Optional - Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=xxxxxxxx

# Database (Optional - for forms/applications)
DATABASE_URL=postgresql://user:pass@localhost:5432/forged_in_fire

# Hotlines & External Resources
NEXT_PUBLIC_HOTLINE_NATIONAL=1-888-373-7888
NEXT_PUBLIC_HOTLINE_SMS=233733
